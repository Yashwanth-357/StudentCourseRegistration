@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="container py-5">
    <div class="state-card mx-auto text-center">
        <div class="state-code">@Model.StatusCode</div>
        <h1 class="h3 mb-2">@Model.Title</h1>
        <p class="text-muted mb-4">@Model.Message</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a class="btn btn-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Go to dashboard</a>
            <a class="btn btn-outline-brand" asp-controller="Student" asp-action="Index">View students</a>
        </div>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mt-4 mb-0">Request ID: <code>@Model.RequestId</code></p>
        }
    </div>
</section>
