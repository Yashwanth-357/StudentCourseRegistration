@* Shows one-time messages stored in TempData by the controllers. *@
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="container pt-4">
        <div class="alert alert-brand alert-dismissible fade show d-flex align-items-center mb-0" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="container pt-4">
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
