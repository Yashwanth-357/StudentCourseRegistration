@model HomeViewModel
@{
    ViewData["Title"] = "Dashboard";

    // Longest bar = 100% width; avoid dividing by zero when nobody is registered.
    var maxInCourse = Model.StudentsPerCourse.Values.DefaultIfEmpty(0).Max();
    if (maxInCourse == 0) { maxInCourse = 1; }
}

<!-- ===== Hero ===== -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow">Student Course Registration System</span>
                <h1 class="hero-title">Register students for the right course, <em>in under a minute.</em></h1>
                <p class="hero-lead">
                    One place to enrol students, look them up and keep track of every course &mdash;
                    simple, fast and always up to date.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-accent btn-lg" asp-controller="Student" asp-action="Create">
                        <i class="bi bi-person-plus me-2"></i>Register a student
                    </a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Student" asp-action="Index">
                        <i class="bi bi-people me-2"></i>View all students
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-panel">
                    <div class="hero-panel-label">Total registered students</div>
                    <div class="hero-panel-number">@Model.TotalStudents</div>
                    <hr />
                    <div class="hero-panel-label mb-2">Latest registrations</div>
                    @if (Model.RecentStudents.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var s in Model.RecentStudents.Take(3))
                            {
                                <li class="hero-mini">
                                    <span class="avatar avatar-sm tone-@s.AvatarTone">@s.Initials</span>
                                    <span class="flex-grow-1 text-truncate">@s.Name</span>
                                    <span class="hero-mini-course">@s.Course</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0 opacity-75">No registrations yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Dashboard ===== -->
<section class="container section">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <span class="stat-icon"><i class="bi bi-people"></i></span>
                <div>
                    <div class="stat-label">Total students</div>
                    <div class="stat-value">@Model.TotalStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <span class="stat-icon"><i class="bi bi-journal-bookmark"></i></span>
                <div>
                    <div class="stat-label">Courses offered</div>
                    <div class="stat-value">@Model.TotalCourses</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <span class="stat-icon"><i class="bi bi-trophy"></i></span>
                <div>
                    <div class="stat-label">Most popular course</div>
                    <div class="stat-value stat-value-sm">@Model.MostPopularCourse</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Students per course -->
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-header">
                    <h2 class="panel-title">Students per course</h2>
                </div>
                <div class="panel-body">
                    @foreach (var item in Model.StudentsPerCourse)
                    {
                        <div class="bar-row">
                            <div class="bar-label">
                                <a asp-controller="Student" asp-action="Index" asp-route-course="@item.Key">@item.Key</a>
                                <span>@item.Value</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width: @(item.Value * 100 / maxInCourse)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent registrations -->
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-header d-flex justify-content-between align-items-center">
                    <h2 class="panel-title">Recent registrations</h2>
                    <a class="small fw-semibold" asp-controller="Student" asp-action="Index">See all</a>
                </div>
                <div class="panel-body p-0">
                    @if (Model.RecentStudents.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var s in Model.RecentStudents)
                            {
                                <li>
                                    <a class="recent-item" asp-controller="Student" asp-action="Details" asp-route-id="@s.Id">
                                        <span class="avatar tone-@s.AvatarTone">@s.Initials</span>
                                        <span class="flex-grow-1">
                                            <span class="d-block fw-semibold">@s.Name</span>
                                            <span class="d-block small text-muted">@s.Course &middot; Semester @s.Semester</span>
                                        </span>
                                        <span class="small text-muted">@s.RegisteredOn.ToString("dd MMM")</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-muted">No students registered yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
