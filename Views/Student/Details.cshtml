@model Student
@{
    ViewData["Title"] = Model.Name;
}

<section class="container section">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb crumbs">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Profile card -->
        <div class="col-lg-4">
            <div class="panel profile-card">
                <span class="avatar avatar-xl tone-@Model.AvatarTone">@Model.Initials</span>
                <h1 class="h4 mt-3 mb-1">@Model.Name</h1>
                <a class="text-muted" href="mailto:@Model.Email">@Model.Email</a>
                <div class="mt-3">
                    <span class="chip chip-course">@Model.Course</span>
                </div>
            </div>
        </div>

        <!-- Details -->
        <div class="col-lg-8">
            <div class="panel">
                <div class="panel-header"><h2 class="panel-title">Registration details</h2></div>
                <div class="panel-body">
                    <dl class="detail-grid mb-0">
                        <div>
                            <dt>Student ID</dt>
                            <dd>@Model.StudentCode</dd>
                        </div>
                        <div>
                            <dt>Full name</dt>
                            <dd>@Model.Name</dd>
                        </div>
                        <div>
                            <dt>Email address</dt>
                            <dd>@Model.Email</dd>
                        </div>
                        <div>
                            <dt>Course</dt>
                            <dd>@Model.Course</dd>
                        </div>
                        <div>
                            <dt>Semester</dt>
                            <dd>Semester @Model.Semester</dd>
                        </div>
                        <div>
                            <dt>Registered on</dt>
                            <dd>@Model.RegisteredOn.ToString("dd MMMM yyyy, hh:mm tt")</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a class="btn btn-outline-brand" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
                <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Register another student</a>
            </div>
        </div>
    </div>
</section>
