@* Shown by StudentController.Details when the requested Id does not exist. The model is the invalid Id. *@
@model int
@{
    ViewData["Title"] = "Student not found";
}

<section class="container py-5">
    <div class="state-card mx-auto text-center">
        <div class="state-code"><i class="bi bi-person-x"></i></div>
        <h1 class="h3 mb-2">Student not found</h1>
        <p class="text-muted mb-4">
            There is no student with the ID <strong>@Model</strong>. The record may not exist or the link may be incorrect.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a class="btn btn-brand" asp-action="Index"><i class="bi bi-people me-1"></i>Back to student list</a>
            <a class="btn btn-outline-brand" asp-action="Create">Register a student</a>
        </div>
    </div>
</section>
